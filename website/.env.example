# Secrets only, non-secret config lives in config.yaml in the repository root.
DB=postgresql://user:password@localhost:5432/peekseek
DISCORD_CLIENT_SECRET=
BOT_TOKEN=
STEAM_API_KEY=

# Optional
SECRET_KEY=
LOG_WEBHOOK=
QUEUE_LOG_CHANNEL=

# Deploy-specific overrides for the app block in config.yaml.
# Leave unset locally; the deployed environments set them.
DOMAIN=
PROTOCOL=
BUILD=

# Grants admin to one steam64 on startup, creating the account if it has never
# logged in. For standing up a fresh environment that has no admin yet, leave
# it unset in production.
BOOTSTRAP_ADMIN_STEAM64=
